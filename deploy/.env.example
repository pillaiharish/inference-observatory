# inference-observatory telemetry stack — example environment configuration
#
# Copy this file to deploy/.env and adjust as needed.
#   cp deploy/.env.example deploy/.env
#
# Do NOT commit deploy/.env. It is gitignored.
# The default demo does NOT require a Hugging Face token.

# --- vLLM --------------------------------------------------------------------

# Pinned vLLM OpenAI server image. Do not use moving tags.
VLLM_IMAGE=vllm/vllm-openai:v0.26.0

# Public, non-gated, small model suitable for single-GPU telemetry demos.
# No HF token and no --trust-remote-code required for this model.
VLLM_MODEL=Qwen/Qwen3-0.6B

# Host port for the vLLM OpenAI API and /metrics endpoint.
VLLM_PORT=8000

# Fraction of GPU memory vLLM may use (0.0–1.0).
VLLM_GPU_MEMORY_UTILIZATION=0.80

# Maximum sequence length the model will accept.
VLLM_MAX_MODEL_LEN=4096

# Optional. Not required by the default public demo model.
# Set to serve a gated/private model. Never commit a real token.
# HF_TOKEN=

# --- DCGM Exporter -----------------------------------------------------------

# Pinned NVIDIA DCGM Exporter image (distroless).
DCGM_EXPORTER_IMAGE=nvcr.io/nvidia/k8s/dcgm-exporter:4.6.0-4.8.3-distroless

# Host port for DCGM Exporter /metrics endpoint.
DCGM_EXPORTER_PORT=9400

# --- Prometheus --------------------------------------------------------------

# Pinned Prometheus image.
PROMETHEUS_IMAGE=prom/prometheus:v3.14.0

# Host port for the Prometheus UI / API.
PROMETHEUS_PORT=9090

# Prometheus TSDB retention for the demo.
PROMETHEUS_RETENTION=24h

# --- GPU ---------------------------------------------------------------------

# Which GPU device id vLLM should use (single-GPU demo).
# DCGM Exporter may still observe all GPUs on the node.
GPU_DEVICE_ID=0